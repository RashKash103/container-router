{
    "name": "container-router",
    "version": "1.2.0",
    "description": "A Firefox extension to route any URL (not just those with a specific domain) into a multi-account container",
    "repository": "ssh://git@github.com/RashKash103/container-router.git",
    "license": "MPL-2.0",
    "scripts": {
        "start": "concurrently \"webpack --watch\" \"yarn web-ext run --source-dir build/webpack\"",
        "watch:webpack": "webpack --watch",
        "test": "node --test tests/*.test.mjs",
        "lint": "yarn web-ext lint"
    },
    "dependencies": {
        "concurrently": "^9.2.1",
        "copy-webpack-plugin": "^13.0.1",
        "css-loader": "^7.1.4",
        "fs-extra": "^11.3.3",
        "html-webpack-plugin": "^5.5.0",
        "sass": "^1.97.3",
        "sass-loader": "^16.0.5",
        "style-loader": "^4.0.0",
        "uuid": "^14.0.1",
        "vue": "^3.5.29",
        "vue-loader": "^17.0.0",
        "web-ext": "^9.3.0",
        "webpack": "^5.105.3",
        "webpack-cli": "^6.0.1"
    },
    "devDependencies": {
        "@types/firefox-webext-browser": "^120.0.4",
        "gulp": "^5.0.1",
        "gulp-clean": "^0.4.0"
    }
}
